{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exam-prep progress state",
  "description": "Checkpoint file. It records what actually happened, not what was intended. The presence of a rendered PDF is never sufficient evidence of completion — the completion_gates block is.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "profile_id",
    "state",
    "current_phase",
    "completed_phases",
    "approval",
    "counts",
    "artifacts",
    "completion_gates",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "state": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "waiting_for_approval",
        "blocked",
        "audit_failed",
        "complete"
      ]
    },
    "current_phase": {
      "type": "string",
      "enum": [
        "phase0_environment",
        "phase1_inventory",
        "phase2_scope",
        "phase3_canonical_content",
        "phase4_verification",
        "phase5_generation",
        "phase6_checkpoint",
        "phase7_qa"
      ]
    },
    "completed_phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "phase0_environment",
          "phase1_inventory",
          "phase2_scope",
          "phase3_canonical_content",
          "phase4_verification",
          "phase5_generation",
          "phase6_checkpoint",
          "phase7_qa"
        ]
      }
    },
    "approval": {
      "type": "object",
      "required": ["outline_approved"],
      "description": "Phase 2 stops for the user. continue_without_approval in the config may pre-authorise this, but the fact must still be recorded here.",
      "properties": {
        "outline_approved": {
          "type": "boolean"
        },
        "approved_at": {
          "type": ["string", "null"]
        },
        "approved_by": {
          "type": ["string", "null"]
        },
        "approval_note": {
          "type": ["string", "null"]
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["expected_problems", "records_present", "settled_records"],
      "properties": {
        "expected_problems": {
          "type": "integer",
          "minimum": 0
        },
        "records_present": {
          "type": "integer",
          "minimum": 0
        },
        "settled_records": {
          "type": "integer",
          "minimum": 0,
          "description": "Records whose status is VERIFIED, VERIFIED_WITH_ROUNDING_DIFFERENCE or OFFICIAL_SOLUTION_CORRECTED."
        },
        "unresolved_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocking_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "description"],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "needs_user_input": {
            "type": "boolean"
          }
        }
      }
    },
    "unresolved_discrepancies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Produced outputs. reported_page_count must equal the count pdf_preflight read from the file itself.",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "path"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "notes_bilingual",
              "notes_english",
              "solutions_bilingual",
              "solutions_english",
              "audit_report",
              "topic_matrix",
              "pdf_qa_report"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": ["string", "null"],
            "enum": ["en", "ko-en", null]
          },
          "format": {
            "type": ["string", "null"],
            "enum": ["pdf", "docx", "md", "json", null]
          },
          "reported_page_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "source_files": {
            "type": "array",
            "description": "Canonical text files this artefact was rendered from.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "pdf_preflight": {
      "type": ["object", "null"],
      "required": ["executed"],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "executed_at": {
          "type": ["string", "null"]
        },
        "passed": {
          "type": ["boolean", "null"]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "visual_review": {
      "type": ["object", "null"],
      "description": "Four independent facts. None of them implies any other. Human review can only be set by a human recording it.",
      "required": [
        "automated_preflight_passed",
        "rendered_pages_generated",
        "automated_visual_heuristics_passed",
        "human_visual_review_recorded"
      ],
      "properties": {
        "automated_preflight_passed": {
          "type": "boolean"
        },
        "rendered_pages_generated": {
          "type": "boolean"
        },
        "automated_visual_heuristics_passed": {
          "type": "boolean"
        },
        "human_visual_review_recorded": {
          "type": "boolean"
        },
        "human_reviewer": {
          "type": ["string", "null"]
        },
        "human_reviewed_at": {
          "type": ["string", "null"]
        },
        "pages_reviewed": {
          "type": ["string", "null"]
        }
      }
    },
    "completion_gates": {
      "type": "object",
      "description": "Every mandatory gate must be true before state may be 'complete'. final_audit.py recomputes these from the files; it does not trust what is written here.",
      "required": [
        "sources_inventoried",
        "outline_approved",
        "canonical_content_complete",
        "all_examples_have_records",
        "no_unresolved_presented_as_verified",
        "language_editions_in_parity",
        "pdf_preflight_executed",
        "page_counts_match_actual",
        "no_stale_verification_records"
      ],
      "properties": {
        "sources_inventoried": {
          "type": "boolean"
        },
        "outline_approved": {
          "type": "boolean"
        },
        "canonical_content_complete": {
          "type": "boolean"
        },
        "all_examples_have_records": {
          "type": "boolean"
        },
        "no_unresolved_presented_as_verified": {
          "type": "boolean"
        },
        "language_editions_in_parity": {
          "type": "boolean"
        },
        "pdf_preflight_executed": {
          "type": "boolean"
        },
        "page_counts_match_actual": {
          "type": "boolean"
        },
        "no_stale_verification_records": {
          "type": "boolean"
        },
        "human_visual_review_recorded": {
          "type": "boolean",
          "description": "Optional gate; required only when the config sets require_human_visual_review."
        }
      }
    },
    "tool_results": {
      "type": "array",
      "description": "Append-only log of script runs, so recovery knows what was actually executed.",
      "items": {
        "type": "object",
        "required": ["tool", "status", "run_at"],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skipped"]
          },
          "run_at": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
