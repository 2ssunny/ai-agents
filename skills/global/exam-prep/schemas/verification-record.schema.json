{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exam-prep problem verification record",
  "description": "Audit record for one worked example or past-paper solution. A record is the ONLY thing that may justify calling a solution verified. Rendering a document proves nothing about the mathematics. The anyOf at the bottom makes a settled status structurally impossible without checks, evidence and a content hash.",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "example_id",
    "chapter_id",
    "profile_id",
    "status",
    "checks",
    "evidence",
    "official_solution",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "example_id": {
      "type": "string",
      "pattern": "^WE-[0-9]{2,}-[0-9]{2,}$",
      "description": "Must match a worked_example block in the canonical content."
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^CH-[0-9]{2,}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "VERIFIED_WITH_ROUNDING_DIFFERENCE",
        "ASSUMPTION_SENSITIVE",
        "OFFICIAL_SOLUTION_CORRECTED",
        "INSUFFICIENT_INFORMATION",
        "UNRESOLVED",
        "NOT_YET_VERIFIED"
      ]
    },
    "checks": {
      "type": "array",
      "description": "One entry per check_id demanded by the profile. Absent entries are treated as not performed, never as passing.",
      "items": {
        "type": "object",
        "required": ["check_id", "result"],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "not_applicable", "not_performed"]
          },
          "note": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Real, resolvable artefacts. Paths are relative to the working directory.",
      "items": {
        "type": "object",
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recorded_derivation",
              "independent_recomputation",
              "verification_script",
              "reference_check",
              "human_review"
            ]
          },
          "path": {
            "type": ["string", "null"],
            "description": "Path to the artefact; required for every kind except reference_check."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "script_hook": {
            "type": ["string", "null"],
            "description": "Optional per-problem checker, run by verify_evidence.py as `python <path>`; exit 0 means the check passed."
          }
        }
      }
    },
    "official_solution": {
      "type": "object",
      "required": ["available", "agreement"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "source_id": {
          "type": ["string", "null"]
        },
        "agreement": {
          "type": "string",
          "enum": ["agrees", "rounding_difference", "differs", "not_compared", "not_available"]
        },
        "discrepancy_id": {
          "type": ["string", "null"],
          "description": "Required when agreement is 'differs'; links to discrepancy-log.json."
        }
      }
    },
    "content_hash": {
      "type": "object",
      "required": ["algorithm", "source_file", "block_id", "value"],
      "description": "Hash of the canonical block at the moment of verification. If the text is later edited the record goes stale and the final audit fails.",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verified_at": {
      "type": ["string", "null"]
    },
    "verified_by": {
      "type": ["string", "null"],
      "enum": ["agent", "human", "agent+human", null]
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "anyOf": [
    {
      "description": "Settled statuses require at least one passing check, at least one evidence item, and a recorded content hash.",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "VERIFIED_WITH_ROUNDING_DIFFERENCE",
            "OFFICIAL_SOLUTION_CORRECTED"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status", "checks", "evidence", "content_hash", "verified_at"]
    },
    {
      "description": "Unsettled statuses carry no evidence obligation, but must never be presented as verified.",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ASSUMPTION_SENSITIVE",
            "INSUFFICIENT_INFORMATION",
            "UNRESOLVED",
            "NOT_YET_VERIFIED"
          ]
        }
      },
      "required": ["status"]
    }
  ]
}
