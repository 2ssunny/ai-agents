{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exam-prep project profile",
  "description": "A subject profile. Defines which verification checks a worked example must pass before it may be marked VERIFIED, plus subject-specific vocabulary and page guidance.",
  "type": "object",
  "required": [
    "profile_id",
    "schema_version",
    "display_name",
    "subject_family",
    "required_checks",
    "page_targets"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable identifier referenced by configs and solution records."
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "subject_family": {
      "type": "string",
      "minLength": 1,
      "description": "Broad grouping, e.g. generic-stem, thermo-fluids, solid-mechanics."
    },
    "description": {
      "type": "string"
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Check IDs that must all be present and passing before VERIFIED is allowed.",
      "items": {
        "type": "object",
        "required": ["check_id", "title"],
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "optional_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["check_id", "title"],
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "formula_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["DS", "MEM", "DERIVE"]
      }
    },
    "page_targets": {
      "type": "object",
      "required": ["minimum_pages", "preferred_min_pages", "preferred_max_pages"],
      "additionalProperties": false,
      "description": "Guidance only. Page counts are never evidence of completion and padding to reach them is prohibited.",
      "properties": {
        "minimum_pages": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_min_pages": {
          "type": "integer",
          "minimum": 1
        },
        "preferred_max_pages": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_advisory_pages": {
          "type": "integer",
          "minimum": 1
        },
        "allow_out_of_range_with_explanation": {
          "type": "boolean"
        }
      }
    },
    "exam_trigger_vocabulary": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Command words that signal a question type in this subject."
    },
    "notes": {
      "type": "string"
    }
  }
}
